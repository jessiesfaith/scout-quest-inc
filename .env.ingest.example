# Stage 3 publisher — copy to .env.ingest and fill in. LOCAL ONLY.
# .env.ingest is gitignored; nothing in this file belongs in the repo.
#
# The publisher runs on the machine that holds the governed ledger and
# pushes a metadata summary to the company OS. It never runs on Vercel,
# and the OS never reads the ledger.
#
#   node scripts/ingest/publish.mjs --dry-run    # print, send nothing
#   node scripts/ingest/publish.mjs              # all four sources
#   node scripts/ingest/publish.mjs --source git

# Where the OS listens. Use the deployed URL, or http://localhost:3000/api/ingest
# while testing against a local dev server.
OS_INGEST_URL=https://scout-quest-inc.vercel.app/api/ingest

# The shared bearer token. Must match INGEST_TOKEN in Vercel exactly.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Anything shorter than 32 characters is refused by the route.
INGEST_TOKEN=

# The ASL ledger — the SQLite file DATABASE_URL points at in asl-gateway.
# For sqlite:///./asl.db that is C:\dev\asl-gateway\asl.db
# A Postgres ledger is not supported by the publisher yet.
ASL_DB=C:\dev\asl-gateway\asl.db

# The agent registry.
ASL_POLICY=C:\dev\asl-gateway\config\spend_policy.yaml

# Repository whose commit history feeds the change log.
# Defaults to this repo when unset.
GIT_REPO=C:\dev\scoutquestaiinc
